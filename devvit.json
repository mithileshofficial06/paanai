{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "paanai",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "studio": {
        "entry": "studio.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "media": true,
    "realtime": false,
    "journeys": true,
    "http": {
      "enable": false
    },
    "reddit": {
      "enable": true,
      "scope": "user"
    }
  },
  "scheduler": {
    "tasks": {
      "daily-rollover": {
        "endpoint": "/internal/cron/daily-rollover",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/install",
    "onAppUpgrade": "/internal/triggers/upgrade"
  },
  "menu": {
    "items": [
      {
        "label": "Paanai: post today's commission now",
        "description": "Creates today's daily post if it does not exist",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Paanai: stats",
        "description": "Today's activity",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/stats"
      }
    ]
  },
  "settings": {
    "subreddit": {
      "minRankToCommission": {
        "type": "select",
        "label": "Rank needed to create commissions",
        "options": [
          {
            "label": "Journeyman",
            "value": "journeyman"
          },
          {
            "label": "Artisan",
            "value": "artisan"
          }
        ],
        "defaultValue": [
          "journeyman"
        ]
      },
      "journeymanPoints": {
        "type": "number",
        "label": "Rank points needed for Journeyman",
        "helpText": "Low for small or test communities. Points: 1 per ranked throw, star and fired pot; 5 per Codex discovery.",
        "defaultValue": 3
      },
      "reportsToHide": {
        "type": "number",
        "label": "Reports before a pot or commission is auto-hidden",
        "defaultValue": 3
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  }
}
