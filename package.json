{
  "private": true,
  "name": "paanai-game",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "harness": "vite --config vite.harness.config.ts",
    "deploy": "npm run test:types && npm run lint && npm run test && devvit upload",
    "launch:AFTER-DEC-9-ONLY": "npm run deploy && devvit publish",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:types": "tsc --build",
    "share:build": "vite build --config vite.share.config.ts && vite build --ssr src/server/harness.ts --config vite.share.config.ts",
    "share": "node tools/serve-share.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.2",
    "@devvit/start": "0.15.2",
    "@devvit/web": "0.15.2",
    "@hono/node-server": "2.1.6",
    "@preact/signals": "^2.11.4",
    "devvit": "0.15.2",
    "hono": "4.13.17",
    "preact": "^11.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "@types/three": "^0.187.0",
    "eslint": "10.14.0",
    "fast-check": "^4.10.2",
    "globals": "17.14.0",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  }
}
